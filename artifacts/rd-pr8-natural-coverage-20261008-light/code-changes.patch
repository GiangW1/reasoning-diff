+def _prose_arithmetic(expression):
+    """Translate explicitly grouped binary arithmetic prose, without evaluation."""
+    pieces, index = [], 0
+    while index < len(expression):
+        if expression[index] != '(':
+            pieces.append(expression[index])
+            index += 1
+            continue
